# Password for the /admin panel (required)
ADMIN_PASSWORD=change-me
# Optional: long random string used to sign admin sessions.
# If left out, a key derived from ADMIN_PASSWORD is used.
SESSION_SECRET=
PORT=3001

# Google sign-in for shoppers: the OAuth "Web application" client ID from Google Cloud Console.
# Leave empty to let shoppers order without signing in.
GOOGLE_CLIENT_ID=

# Supabase (recommended): data in Postgres tables, photos in Storage. Use the secret key
# (sb_secret_…) or legacy service_role key — server only, never in front-end code.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=

# Optional alternative: Upstash Redis instead of server/db.json + server/uploads.
# On Vercel these are added automatically when you connect an Upstash Redis database.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
